<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UsingBinding.Views.LogIn"
             Title="LogIn">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Sign In To Muscle Up"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,20,0,20" />

            <Label Text="Enter your Email:" />
            <Entry x:Name="Email" Placeholder="Email" />
            <Label x:Name="errEmail" TextColor="Red"/>

            <Label Text="Enter your password:" />
            <Entry x:Name="PassWord"
               Placeholder="Password"
               IsPassword="True" />
            <Label x:Name="errPassword" TextColor="Red"/>

            <Label Text="Don't have an account? Register"
                TextColor="Blue"
                HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterClicked" />
                </Label.GestureRecognizers>
            </Label>

            <Button Text="Sign In" 
                    Clicked="OnSignInClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>